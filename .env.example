# All optional. Without them the site still renders; the waitlist just stops
# reading/writing and analytics stays off.
# Anything prefixed VITE_ is inlined into the public JS bundle at build time —
# only ever put publishable/anon keys here, never a service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
